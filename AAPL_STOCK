# SARIMA Model
import pandas as pd
import matplotlib.pyplot as plt
from statsmodels.tsa.statespace.sarimax import SARIMAX

# Ensure datetime index
df.index = pd.to_datetime(df.index)

# Automatically pick the first numeric column if "Value" is not present
numeric_cols = df.select_dtypes(include=['float64','int64']).columns
if "Value" in df.columns:
    target_col = "Value"
else:
    target_col = numeric_cols[0]   # use the first numeric column
print(f"Using column '{target_col}' for SARIMA modeling.")

# Train-test split
train_size = int(len(df) * 0.8)
train, test = df.iloc[:train_size], df.iloc[train_size:]

# Fit SARIMA model
sarima_model = SARIMAX(train[target_col],
                       order=(1,1,1),              # (p,d,q)
                       seasonal_order=(1,1,1,12),  # (P,D,Q,m) - m=12 for monthly data
                       enforce_stationarity=False,
                       enforce_invertibility=False)

sarima_result = sarima_model.fit(disp=False)

# Forecast
sarima_forecast = sarima_result.get_forecast(steps=len(test))
sarima_pred = sarima_forecast.predicted_mean
sarima_conf = sarima_forecast.conf_int()

# Plot
plt.figure(figsize=(12,6))
plt.plot(train.index, train[target_col], label='Train')
plt.plot(test.index, test[target_col], label='Test')
plt.plot(sarima_pred.index, sarima_pred, label='SARIMA Forecast', color='red')
plt.fill_between(sarima_conf.index,
                 sarima_conf.iloc[:, 0],
                 sarima_conf.iloc[:, 1], color='pink', alpha=0.3)
plt.legend()
plt.show()


# Prophet Model
import pandas as pd
import matplotlib.pyplot as plt
from prophet import Prophet

# Ensure datetime index
df.index = pd.to_datetime(df.index)

# Pick the same target column we used in SARIMA
numeric_cols = df.select_dtypes(include=['float64','int64']).columns
if "Value" in df.columns:
    target_col = "Value"
else:
    target_col = numeric_cols[0]
print(f"Using column '{target_col}' for Prophet modeling.")

# Prepare data for Prophet
prophet_df = df[[target_col]].reset_index()
prophet_df.columns = ['ds', 'y']   # Prophet needs columns 'ds' (date), 'y' (target)

# Train-test split
train_size = int(len(prophet_df) * 0.8)
train, test = prophet_df.iloc[:train_size], prophet_df.iloc[train_size:]

# Fit Prophet model
model = Prophet()
model.fit(train)

# Forecast
future = model.make_future_dataframe(periods=len(test), freq='D')  # adjust freq if not daily
forecast = model.predict(future)

# Plot forecast vs actual
plt.figure(figsize=(12,6))
plt.plot(train['ds'], train['y'], label='Train')
plt.plot(test['ds'], test['y'], label='Test')
plt.plot(forecast['ds'], forecast['yhat'], label='Prophet Forecast', color='red')
plt.fill_between(forecast['ds'],
                 forecast['yhat_lower'],
                 forecast['yhat_upper'], color='pink', alpha=0.3)


# LSTM Model
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import MinMaxScaler
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense

# Ensure datetime index
df.index = pd.to_datetime(df.index)

# Pick the same target column
numeric_cols = df.select_dtypes(include=['float64','int64']).columns
if "Value" in df.columns:
    target_col = "Value"
else:
    target_col = numeric_cols[0]
print(f"Using column '{target_col}' for LSTM modeling.")

# Extract values
data = df[[target_col]].values

# Scale data (LSTM works better with normalized values)
scaler = MinMaxScaler(feature_range=(0, 1))
scaled_data = scaler.fit_transform(data)

# Train-test split
train_size = int(len(scaled_data) * 0.8)
train, test = scaled_data[:train_size], scaled_data[train_size:]

# Function to create sequences
def create_sequences(dataset, time_step=30):
    X, y = [], []
    for i in range(len(dataset) - time_step):
        X.append(dataset[i:(i + time_step), 0])
        y.append(dataset[i + time_step, 0])
    return np.array(X), np.array(y)

time_step = 30  # how many past steps to look back
X_train, y_train = create_sequences(train, time_step)
X_test, y_test = create_sequences(test, time_step)

# Reshape for LSTM [samples, time_steps, features]
X_train = X_train.reshape((X_train.shape[0], X_train.shape[1], 1))
X_test = X_test.reshape((X_test.shape[0], X_test.shape[1], 1))

# Build LSTM model
model = Sequential()
model.add(LSTM(50, return_sequences=True, input_shape=(time_step, 1)))
model.add(LSTM(50, return_sequences=False))
model.add(Dense(25))
model.add(Dense(1))

model.compile(optimizer='adam', loss='mean_squared_error')

# Train model
history = model.fit(X_train, y_train, batch_size=32, epochs=20, verbose=1)

# Predictions
train_pred = model.predict(X_train)
test_pred = model.predict(X_test)

# Inverse transform to original scale
train_pred = scaler.inverse_transform(train_pred)
test_pred = scaler.inverse_transform(test_pred)
y_train_actual = scaler.inverse_transform(y_train.reshape(-1,1))
y_test_actual = scaler.inverse_transform(y_test.reshape(-1,1))

# Plot
plt.figure(figsize=(12,6))
plt.plot(df.index, data, label='Original Data')
plt.plot(df.index[time_step:train_size], train_pred, label='Train Prediction')
plt.plot(df.index[train_size+time_step:], test_pred, label='Test Prediction', color='red')
plt.legend()
plt.show()


